addSignal -c ID_YELLOW7 -ls solid -lw 1 -h 15 -UNSIGNED -UDEC -holdScope pax_cnt_0[3:0]
addSignal -c ID_ORANGE5 -ls solid -lw 1 -h 15 -UNSIGNED -UDEC -holdScope cur_floor_0[2:0]
addSignal -c ID_PURPLE7 -ls solid -lw 1 -h 15 -UNSIGNED -holdScope lift_status_0[2:0]
addSignal -c ID_GRAY6 -ls solid -lw 1 -h 15 -UNSIGNED -holdScope serve_dir_0[1:0]
addGroup "Signals for E1"
