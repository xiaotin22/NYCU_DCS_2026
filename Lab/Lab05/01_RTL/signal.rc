Magic 271485
Revision Verdi_P-2019.06

; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 1920 23 1920 1009 157 76

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / ""

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
; waveform viewport range
zoom 0.000000 500000.000000
cursor 0.000000
marker 0.000000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 0
; marker line index
markerPos 13

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "G1"
activeDirFile ""
addSignal -h 15 /TESTBED/clk
addSignal -h 15 -holdScope rst_n
addGroup "G2"
addSignal -h 15 /TESTBED/in_valid
addSignal -h 15 -UNSIGNED -HEX -holdScope in_digit[3:0]
addSignal -h 15 -holdScope enter
addSignal -h 15 -holdScope change
addSignal -h 15 -holdScope lock_reset
addGroup "G3"
addSignal -h 15 -UNSIGNED /TESTBED/state[2:0]
addSignal -h 15 -holdScope unlocked
addSignal -h 15 -holdScope alarm
addGroup "G4"

; getSignalForm Scope Hierarchy Status
; active file of getSignalForm
activeDirFile ""

GETSIGNALFORM_SCOPE_HIERARCHY_BEGIN
getSignalForm close

"/TESTBED"
"/TESTBED/I_LOCK"
"/TESTBED/I_PATTERN"

SCOPE_LIST_BEGIN
"/TESTBED"
"/TESTBED/I_LOCK"
"/TESTBED/I_PATTERN"
SCOPE_LIST_END

GETSIGNALFORM_SCOPE_HIERARCHY_END


