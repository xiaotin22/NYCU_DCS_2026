; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 27 1920 432 147 65

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / -i 0 "" "/RAID2/COURSE/2026_Spring/es26dcs/es26dcs151/Lab10/01_RTL/axis_wrapper.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
; waveform viewport range
zoom 0.000000 1722669.789674
cursor 1440000.000000
marker 0.000000

; visible top row signal index
top 0
; marker line index
markerPos 23

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


aliasmapname PATTERN(@1).PATNUM
nalias PAT_NUM		32'b00000000000000000000000001100100		NULL

aliasmapname PATTERN(@1).SEED
nalias RAND_SEED		32'b00000000000000001101001111100011		NULL

aliasmapname PATTERN(@1).check
nalias CHECK		1'b1		NULL

aliasmapname TESTBED.I_axis_wrapper.state
nalias WAIT0		3'b010		NULL
nalias AXI_OUT		3'b110		NULL
nalias SOBEL_IN		3'b011		NULL
nalias IDLE		3'b000		NULL
nalias SOBEL_OUT		3'b100		NULL
nalias AXI_IN		3'b001		NULL
nalias WAIT1		3'b101		NULL

addGroup "G1"
activeDirFile "" "/RAID2/COURSE/2026_Spring/es26dcs/es26dcs151/Lab10/01_RTL/axis_wrapper.fsdb"
addSignal -h 15 /TESTBED/axis_aclk
